# Native local setup fills sinference/.env automatically with a generated password.
# For hosted Tiger Data, paste its full PostgreSQL connection string and sslmode.
# This connection is used only by the central backend.
DATABASE_URL=

# The site's public origin; nodes connect to its host on port 1027.
PUBLIC_URL=https://localhost:1025

# Solana (docs/solana.md). Leave SOLANA_PROGRAM unset to run w/o stakes or payouts.
SOLANA_PROGRAM=
SOLANA_RPC=https://api.devnet.solana.com
SOLANA_KEYPAIR=
MIN_STAKE_USD=20
